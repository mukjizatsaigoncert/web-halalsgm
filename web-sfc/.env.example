# ==========================================================================
# Next.js Frontend Environment Variables
# ==========================================================================
# Copy this file to .env.local and fill in values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — never put
# server-only secrets there.
# ==========================================================================

# ---- Strapi API ----
# Public URL of the Strapi backend (used by server and client components)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Server-only Strapi API token (optional — used for privileged fetches).
# Leave empty to use anonymous public role.
STRAPI_API_TOKEN=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- reCAPTCHA v3 (contact form) ----
# Site key is safe to expose; secret key lives on backend only.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ---- Analytics (optional) ----
# NEXT_PUBLIC_GTM_ID=

# ---- Observability (optional) ----
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
