# ==========================================================================
# docker-compose environment (root of repo)
# Copy to .env and fill in values before: docker compose up -d
# ==========================================================================

# ---- Database ----
POSTGRES_DB=sfc
POSTGRES_USER=sfc
# Required. Use: openssl rand -base64 24
POSTGRES_PASSWORD=

# ---- Redis ----
REDIS_PASSWORD=
# Cache TTL for API responses (seconds). 300 = 5 min recommended for production.
REDIS_CACHE_TTL=300

# ---- Cloudflare R2 Storage (production only) ----
# Leave blank in dev → Strapi uses local disk storage
# R2_ACCOUNT_ID:        Cloudflare Account ID (dashboard → right sidebar)
# R2_ACCESS_KEY_ID:     R2 API Token → Manage R2 API Tokens → Access Key ID
# R2_SECRET_ACCESS_KEY: R2 API Token → Secret Access Key
# R2_BUCKET:            R2 bucket name (e.g. sfc-uploads)
# R2_PUBLIC_URL:        Public URL of the bucket (e.g. https://uploads.sfc.vn)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sfc-uploads
R2_PUBLIC_URL=

# ---- Strapi secrets ----
# Required. Generate all six with: ./backend-sfc/scripts/generate-secrets.sh
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# ---- Public URLs (update for your domain) ----
BACKEND_PUBLIC_URL=https://api.sfc.vn
NEXT_PUBLIC_STRAPI_URL=https://api.sfc.vn
NEXT_PUBLIC_SITE_URL=https://sfc.vn

# ---- Security ----
# Comma-separated list of FE origins allowed to call the API.
CORS_ORIGINS=https://sfc.vn,https://www.sfc.vn

# ---- reCAPTCHA v3 ----
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# ---- Observability (optional) ----
FRONTEND_SENTRY_DSN=
BACKEND_SENTRY_DSN=
SENTRY_ENV=production
