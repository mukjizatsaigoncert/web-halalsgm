# ==========================================================================
# docker-compose environment (root of repo)
# Copy to .env and fill in values before: docker compose up -d
# ==========================================================================

# ---- Nginx host ports ----
HTTP_PORT=80
HTTPS_PORT=443

# ---- Database ----
POSTGRES_DB=halal
POSTGRES_USER=halal
# Required. Use: openssl rand -base64 24
POSTGRES_PASSWORD=

# ---- Redis ----
REDIS_PASSWORD=
# Cache TTL for API responses (seconds). 300 = 5 min recommended for production.
REDIS_CACHE_TTL=300

# ---- Cloudflare R2 Storage (production only) ----
# Leave blank in dev → Strapi uses local disk storage
# R2_ACCOUNT_ID:        Cloudflare Account ID (dashboard → right sidebar)
# R2_ACCESS_KEY_ID:     R2 API Token → Manage R2 API Tokens → Access Key ID
# R2_SECRET_ACCESS_KEY: R2 API Token → Secret Access Key
# R2_BUCKET:            R2 bucket name (e.g. halal-uploads)
# R2_PUBLIC_URL:        Public URL of the bucket (e.g. https://uploads.halalsgm.vn)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=halal-uploads
R2_PUBLIC_URL=

# ---- Strapi secrets ----
# Required. Generate all six with: ./backend-halal/scripts/generate-secrets.sh
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# ---- Public URLs (update for your domain) ----
BACKEND_PUBLIC_URL=https://api.halalsgm.vn
NEXT_PUBLIC_STRAPI_URL=https://api.halalsgm.vn
NEXT_PUBLIC_SITE_URL=https://halalsgm.vn

# ---- Security ----
# Comma-separated list of FE origins allowed to call the API.
CORS_ORIGINS=https://halalsgm.vn,https://www.halalsgm.vn

# ---- reCAPTCHA v3 ----
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# ---- Next.js cache revalidation webhook secret ----
# Generate: openssl rand -hex 32
# Set same value in Strapi webhook → Authorization header: Bearer <token>
REVALIDATE_SECRET=

# Strapi Hero Slider preview (generate with: openssl rand -hex 32)
PREVIEW_SECRET=

# ---- Metrics endpoint (optional) ----
# Protects /api/health/metrics — generate: openssl rand -hex 16
METRICS_TOKEN=

# ---- Observability (optional) ----
FRONTEND_SENTRY_DSN=
BACKEND_SENTRY_DSN=
SENTRY_ENV=production
